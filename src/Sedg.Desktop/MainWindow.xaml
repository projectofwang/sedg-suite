<Window x:Class="Sedg.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Sedg.Desktop.Views"
        Title="{Binding Title}"
        Height="640" Width="960"
        MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <DockPanel>
        <!-- Header: title + navigation (§5.1 shell). -->
        <Border DockPanel.Dock="Top" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="12,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button Content="{Binding NavOperation}" Margin="4,0" Padding="12,4"
                            Command="{Binding ShowOperationCommand}" />
                    <Button Content="{Binding NavDashboard}" Margin="4,0" Padding="12,4"
                            Command="{Binding ShowDashboardCommand}" />
                    <Button Content="{Binding NavSettings}" Margin="4,0" Padding="12,4"
                            Command="{Binding ShowSettingsCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Status bar: broker state text + retry elevation (REQ-002 observable reason). -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="12,6">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="{Binding RetryElevationLabel}"
                        Command="{Binding RetryElevationCommand}"
                        Visibility="{Binding ShowRetryElevation, Converter={StaticResource BoolToVis}}"
                        Padding="12,2" />
                <TextBlock Text="{Binding BrokerStatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- Three stacked views, one visible at a time (§5.1). -->
        <Grid>
            <views:DashboardView
                DataContext="{Binding Dashboard}"
                Visibility="{Binding DataContext.IsActiveDashboard, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
            <views:OperationView
                DataContext="{Binding Operation}"
                Visibility="{Binding DataContext.IsActiveOperation, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
            <views:SettingsView
                DataContext="{Binding Settings}"
                Visibility="{Binding DataContext.IsActiveSettings, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
        </Grid>
    </DockPanel>
</Window>
