<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Sedg.UnitTests</RootNamespace>
    <AssemblyName>Sedg.UnitTests</AssemblyName>
    <SelfContained>false</SelfContained>
    <!-- Task 5 test harness: zero PackageReference by design (design 8.3). -->
  </PropertyGroup>

  <!-- Project references so a clean clone builds the three owner projects and the harness never tests stale DLLs. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Sedg.Protocol\Sedg.Protocol.csproj" />
    <ProjectReference Include="..\..\src\Sedg.Broker\Sedg.Broker.csproj" />
    <ProjectReference Include="..\..\src\Sedg.Desktop\Sedg.Desktop.csproj" />
  </ItemGroup>

</Project>
